# Discord Bot Token (optional: if empty, runs in Web Dashboard + REST API mode; set on your host for live Discord bot)
DISCORD_TOKEN=
# Optional Discord Guild ID for instant slash command sync during development
DISCORD_GUILD_ID=
# Web Server Port (default 3000)
PORT=3000
# Optional SQLite database path (default: ./data/study_bot.db)
STUDY_BOT_DB_PATH=./data/study_bot.db
